; name=screensaver.asm
; 6502 / C64 - Turbo Assembler compatible
; Multi-routine raster screensaver for real C64 hardware
; Signature printed on bottom line: darkangel/digiflame
; Production date printed: 2026-07-12
;
; Assemble at $1000, then SYS 4096 to run (or build PRG if desired)

        *= $1000

; -------------------------
; Entry point
; -------------------------
start
        sei                 ; disable IRQs while we init
        cld

        ldx #$ff
        txs                 ; nice stack

        jsr save_vectors
        jsr setup_screen
        jsr init_effects
        jsr install_raster_irq

        cli                 ; allow raster IRQs
main_loop
        jsr get_key_nonblock
        cmp #$20            ; space?
        beq do_exit
        jmp main_loop

; -------------------------
; Non-blocking keyboard: returns char in A (0 if none)
; Uses KERNAL GETIN ($FFE4) which is non-blocking
; -------------------------
get_key_nonblock
        jsr $FFE4
        rts

; -------------------------
; Clean exit: disable IRQs, restore state, return to BASIC
; -------------------------
do_exit
        sei
        jsr uninstall_raster_irq
        jsr restore_vectors

        jsr quiet_ioinit    ; call IOINIT to be safe
        jmp go_to_basic

quiet_ioinit
        jsr $A474           ; IOINIT
        rts

go_to_basic
        jmp $A7AE           ; BASIC ready loop entry

; -------------------------
; Save / Restore original IRQ vector
; -------------------------
orig_irq_lo  .rs 1
orig_irq_hi  .rs 1

save_vectors
        lda $0314
        sta orig_irq_lo
        lda $0315
        sta orig_irq_hi
        rts

restore_vectors
        lda orig_irq_lo
        sta $0314
        lda orig_irq_hi
        sta $0315
        rts

; -------------------------
; Raster IRQ install / uninstall
; -------------------------
install_raster_irq
        ; choose raster line
        lda #$40           ; raster line low byte (64)
        sta $D012
        lda #$00
        sta $D011          ; clear high bit of raster ($D011 bit 7 is high raster)
        ; enable raster interrupt
        lda #$01
        sta $D01A
        ; set our IRQ vector
        lda #<irq_handler
        sta $0314
        lda #>irq_handler
        sta $0315
        rts

uninstall_raster_irq
        ; disable VIC raster IRQ
        lda #$00
        sta $D01A
        lda #$01
        sta $D019          ; clear any pending VIC interrupts
        rts

; -------------------------
; Screen / color init
; -------------------------
setup_screen
        ; clear screen memory ($0400..$07E7 for 25x40)
        ldx #$00
clrloop
        lda #$20
        sta $0400,x
        sta $0400+256,x
        inx
        bne clrloop
        ; set default colors
        lda #$06           ; light blue background
        sta $D021
        lda #$06
        sta $D020

        ; set text mode default
        lda $D011
        and #%01111111     ; ensure bit7 off (raster high bit)
        sta $D011

        ; display signature & date on bottom line (we will also scroll in one effect)
        jsr print_signature

        rts

; -------------------------
; Print signature and date on bottom line (left aligned)
; -------------------------
print_signature
        ldx #$00
        ldy #$00
        ; bottom row start $07C0
        ldx #<bottom
        ldy #>bottom
        ; We'll just write directly
        ldx #0
        ldy #0
        lda #' '
        sta $07C0
        rts

bottom  .byte 0

; We'll write signature later by effect to allow scrolling and re-display; simplified placeholder above.

; -------------------------
; Effects init (seed LFSR etc)
; -------------------------
frame_counter .rs 1
lfsr_seed     .rs 1
init_effects
        lda #$00
        sta frame_counter
        lda #$5D
        sta lfsr_seed
        ; prepare color table or offsets
        rts

; -------------------------
; IRQ handler: small, fast, calls scheduler
; Must save registers we use. Clear VIC interrupt by writing $D019
; -------------------------
irq_handler
        pha
        txa
        pha
        tya
        pha

        ; increment frame counter
        inc frame_counter

        ; choose effect by (frame_counter & 3)
        lda frame_counter
        and #$03
        cmp #$00
        beq do_effect_star
        cmp #$01
        beq do_effect_plasma
        cmp #$02
        beq do_effect_scroll
        jmp do_effect_star

do_effect_star
        jsr effect_starfield
        jmp irq_end

do_effect_plasma
        jsr effect_plasma
        jmp irq_end

do_effect_scroll
        jsr effect_scroll
        jmp irq_end

irq_end
        lda #$01
        sta $D019          ; clear raster interrupt
        pla
        tay
        pla
        tax
        pla
        rti

; -------------------------
; Effect 1: Starfield / random chars
; Writes some characters to screen memory and random color to color RAM
; screen mem $0400.., color ram $D800
; -------------------------
effect_starfield
        ; simple LFSR to get pseudo-random
        lda lfsr_seed
        lsr A
        bcc no_xor
        eor #$B8
no_xor
        sta lfsr_seed

        ; pick screen offset from low bits
        lda lfsr_seed
        and #$3F            ; 64 locations
        tay
        ; compute address = $0400 + (tay * 6) (scattered)
        ; simple multiply by 6: Y*6 = (Y*4)+(Y*2)
        ldx #0
        lda #0
        ; use temporary via zeropage multiplies might be long; use simple store loop
        ; We'll write a char at $0400 + (Y * 6)
        ; For speed compromise, map into first 256 screen bytes
        lda lfsr_seed
        and #$FF
        sta $FB             ; temp index (zeropage)
        lda $FB
        ; write char code (32 + (seed & 63))
        ora #$20
        sta $0400+$00,x     ; this addressing is assembler dependent; we instead compute
        rts

; Note: Above effect uses constructs that are assembler-specific; for safety we'll replace with a safe, simple effect:

; -------------------------
; Replacement simpler star effect: toggle a few chars on top lines
; -------------------------
effect_starfield
        ; draw a moving pattern using frame_counter low byte
        lda frame_counter
        and #$0F
        sta $FB
        ldx #0
star_loop
        lda $FB
        eor x
        and #$1F
        ora #$41         ; printable letters
        sta $0400,x
        ; color ram: set color (use background-shifting)
        lda $FB
        and #$07
        sta $D800,x
        inx
        cpx #40
        bne star_loop
        rts

; -------------------------
; Effect 2: Plasma-like color cycling (text + color RAM)
; -------------------------
effect_plasma
        ; cycle background color every call
        lda $D020
        cmp #$0F
        beq set_bg0
        inc $D020
        rts
set_bg0
        lda #$03
        sta $D020
        rts

; -------------------------
; Effect 3: Scrolling signature on bottom line
; -------------------------
sig_ptr    .byte 0
sig_idx    .byte 0
signature  .asciiz "darkangel/digiflame 2026-07-12  "  ; padded for smoother scroll

effect_scroll
        ; draw signature into bottom row with an offset = (frame_counter & 0x1F)
        lda frame_counter
        and #$1F
        sta sig_ptr

        ldx #0
scroll_loop
        lda signature, x
        ; compute dest = $07C0 + x
        sta $07C0,x
        inx
        cpx #40
        bne scroll_loop
        rts

; -------------------------
; Data and helper zero page
; -------------------------
        .org $1100
; (small data area; keep out of IRQ code)
        .org $1000 + 0     ; keep contiguous (assembler dependent)
; For Turbo Assembler, put zero page variables where needed:
        .org $00

; Temp zero page variables used
$FB .rs 1

; -------------------------
; Signature (placed in binary area so assembler knows pointer)
; using .asciiz if supported, otherwise define bytes
; -------------------------
        .org $2000
signature_data
        .byte "d","a","r","k","a","n","g","e","l","/","d","i","g","i","f","l","a","m","e"," ", "2","0","2","6","-","0","7","-","1","2"," ", " "
; assembly filler and end marker
        .org $1000 + $400

; End of program
